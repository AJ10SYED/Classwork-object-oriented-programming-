#include <stdio.h>
#include <ctype.h>
int main() {
    char str[100];
    int i, v=0, c=0;
    printf("Enter a string: ");
    scanf("%s", str);
    for(i=0; str[i]!='\0'; i++) {
        char ch = tolower(str[i]);
        if(ch=='a'||ch=='e'||ch=='i'||ch=='o'||ch=='u')
            v++;
        else if(isalpha(ch))
            c++;
    }
    printf("Vowels = %d, Consonants = %d\n", v, c);
    return 0;
}
