#include <stdio.h>
int main() {
    int marks[5], total=0;
    float avg, perc;
    char grade;
    printf("Enter marks of 5 subjects: ");
    for(int i=0; i<5; i++) {
        scanf("%d", &marks[i]);
        total += marks[i];
    }
    avg = total / 5.0;
    perc = (total / 500.0) * 100;

    if(perc >= 90) grade='A';
    else if(perc >= 75) grade='B';
    else if(perc >= 50) grade='C';
    else grade='F';

    printf("Total = %d\nAverage = %.2f\nPercentage = %.2f%%\nGrade = %c\n",
           total, avg, perc, grade);
    return 0;
}
